# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://pactai:password@localhost:5432/pactai_db

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Phone number linked to Baileys session (international format, no +)
WHATSAPP_PHONE_NUMBER=2348000000000

# ─── Admin ────────────────────────────────────────────────────────────────────
# WhatsApp number of the platform admin (receives dispute notifications)
ADMIN_WHATSAPP_NUMBER=2348000000001

# ─── Flutterwave ──────────────────────────────────────────────────────────────
# Get these from your Flutterwave dashboard → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
# Set this under Flutterwave dashboard → Settings → Webhooks
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret-hash

# ─── Public URL ───────────────────────────────────────────────────────────────
# The public URL of this server (used for Flutterwave payment redirect + webhooks)
# On Railway this is auto-assigned, e.g. https://pactai.up.railway.app
APP_BASE_URL=https://your-app.up.railway.app
